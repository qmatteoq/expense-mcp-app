{
  "name": "expense-mcp-app",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal anonymous MCP app rendering an interactive expense-submission widget inside Microsoft 365 Copilot.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-widget.mjs && tsc",
    "build:widget": "node scripts/build-widget.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "package:plugin": "node scripts/build-icons.mjs && node scripts/package-plugin.mjs",
    "check:connector": "node scripts/check-connector.mjs",
    "tunnel:url": "node scripts/resolve-tunnel-url.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "@types/express": "^5.0.0",
    "esbuild": "^0.25.0"
  }
}
