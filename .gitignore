# Dependencies
node_modules/

# Build output (server, bundled widget, plugin zip) — all regenerated by `npm run build`
dist/

# Logs
*.log

# Local dev tunnel URL, written by `npm run tunnel:url` (and by the "Run with
# Dev Tunnel" launch profile). Machine-specific, so it stays out of the repo —
# this is what keeps the placeholder in cowork-plugin/manifest.json untouched.
.tunnel-url

# OS / editor cruft
.DS_Store
Thumbs.db

# Note: cowork-plugin/*.png icons ARE committed on purpose. They are generated
# placeholders (`npm run build:icons`) so the package builds without extra assets.
