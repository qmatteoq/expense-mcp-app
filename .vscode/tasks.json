{
  // Tasks supporting the "Run with Dev Tunnel" launch profile.
  "version": "2.0.0",
  "tasks": [
    {
      // Bundle the widget + compile the server before launching.
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      // Host the PERSISTENT named dev tunnel "expense-mcp" so M365 Copilot can
      // reach the local MCP server at a STABLE URL that survives restarts:
      //   https://<id>-3000.<region>.devtunnels.ms/mcp
      // The tunnel was created once with:
      //   devtunnel create expense-mcp --allow-anonymous
      //   devtunnel port create expense-mcp -p 3000
      // Requires the devtunnel CLI (https://aka.ms/devtunnels/download) and a
      // one-time `devtunnel user login`. Tunnels expire after 30 days of
      // inactivity; re-run the two create commands if it lapses.
      "label": "dev-tunnel",
      "type": "shell",
      "isBackground": true,
      "command": "devtunnel",
      "args": ["host", "expense-mcp"],
      "presentation": {
        "panel": "dedicated",
        "group": "run-with-tunnel",
        "reveal": "always"
      },
      "problemMatcher": {
        // The tunnel never emits compiler-style diagnostics; this matcher only
        // detects when hosting is ready so the launch can proceed.
        "pattern": [
          {
            "regexp": "^(.*)$",
            "file": 1,
            "location": 1,
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Hosting port|Starting tunnel|Connecting to host).*",
          "endsPattern": ".*Ready to accept connections.*"
        }
      }
    },
    {
      // Once the tunnel reports ready, resolve its public URL, write it to
      // .tunnel-url (git-ignored), and rebuild dist/cowork-plugin.zip against
      // that exact URL — so the zip on disk always matches the tunnel that is
      // actually running. The placeholder in cowork-plugin/manifest.json is
      // never rewritten, so your working tree stays clean.
      // --soft: a tunnel hiccup warns instead of blocking the debug session.
      // Invoked via node rather than `npm run -- --soft`, because npm does not
      // reliably forward the flag through to the script.
      "label": "resolve-tunnel-url",
      "type": "shell",
      "command": "node",
      "args": ["scripts/resolve-tunnel-url.mjs", "--soft", "--package"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "panel": "dedicated",
        "group": "run-with-tunnel",
        // Shown, but without stealing focus: --soft turns packaging problems
        // into warnings, so this panel is the only place they surface.
        "reveal": "always",
        "focus": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      // Build, host the tunnel, then capture its URL and repackage the plugin;
      // used as the launch preLaunchTask.
      "label": "build-and-tunnel",
      "dependsOrder": "sequence",
      "dependsOn": ["build", "dev-tunnel", "resolve-tunnel-url"]
    }
  ]
}
